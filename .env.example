# =============================================================================
# PowerSim AI — environment configuration
# Copy to `.env` and adjust. All variables are optional; defaults shown below.
# =============================================================================

# --- Application -------------------------------------------------------------
POWERSIM_APP_NAME="PowerSim AI"
POWERSIM_ENVIRONMENT=development          # development | staging | production
POWERSIM_HOST=0.0.0.0
POWERSIM_PORT=8000

# --- Simulation --------------------------------------------------------------
POWERSIM_SIMULATION_SEED=42               # Reproducible runs; change for variety
POWERSIM_SIMULATION_TICK_SECONDS=2.0      # Wall-clock seconds per simulation tick
POWERSIM_TELEMETRY_HISTORY_POINTS=120     # Ring-buffer size per asset
POWERSIM_WEBSOCKET_HEARTBEAT_SECONDS=30.0

# --- AI agent / Ollama LLM ---------------------------------------------------
POWERSIM_OLLAMA_ENABLED=true              # false = rule-based reasoning only
OLLAMA_URL=http://localhost:11434         # In docker-compose: http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
POWERSIM_OLLAMA_TIMEOUT_SECONDS=30.0
POWERSIM_AGENT_LLM_EVERY_N_CYCLES=5       # LLM narrative pass cadence (rules run every cycle)
POWERSIM_AGENT_CYCLE_EVERY_N_TICKS=1      # Agent evaluates the fleet every N ticks

# --- Observability -----------------------------------------------------------
POWERSIM_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
POWERSIM_LOG_JSON=false                    # true = structured JSON logs (prod)

# --- API hardening -----------------------------------------------------------
POWERSIM_CORS_ALLOW_ORIGINS=*              # Comma-separated list, or * for any
POWERSIM_MAX_WS_CONNECTIONS=200
